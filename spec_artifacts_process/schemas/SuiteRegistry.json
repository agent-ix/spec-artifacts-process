{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/SuiteRegistry.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/UpperDocId.json"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json"
    },
    "type": {
      "type": "string",
      "const": "SuiteRegistry"
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Provenance.json"
    },
    "suites": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/SuiteRow.json"
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "provenance",
    "suites"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Suite registry record (archetype `SuiteRegistry`). An **evidence act**, not a\ndefinition and not a run: it declares which suites exist, what runs them and\nwhat kind of evidence they produce, and declares nothing about any particular\nexecution (FR-013)."
}
