{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/ReleaseRationaleRow.json",
  "type": "object",
  "properties": {
    "author": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NamedText.json"
    },
    "rationale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NamedText.json"
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/LineNumber.json"
