{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "type", "scope", "rating", "rated_by", "intended_use", "relationships"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^FRR-[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "FeatureRiskRating"},
    "scope": {"enum": ["supplier", "adopter"]},
    "rating": {"enum": ["high_process_risk", "not_high_process_risk"]},
    "rated_by": {"type": "string", "minLength": 1},
    "intended_use": {"type": "string", "minLength": 1},
    "relationships": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["target", "type"], "additionalProperties": false, "properties": {"target": {"type": "string", "pattern": "^ix://"}, "type": {"enum": ["rates_feature", "re_rates", "references"]}, "cardinality": {"type": "string"}}}}
  }
}
