{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Task.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/MixedDocId.json"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json"
    },
    "type": {
      "type": "string",
      "const": "Task"
    },
    "object": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/ObjectTypeName.json"
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json",
      "description": "free text: the authored lifecycle word (`todo`, `done`); the archetype declares no vocabulary for it."
    },
    "track": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json",
      "description": "The parallel-execution track label (FR-005). A property of a Task; a consumer needing a tree node synthesises one."
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Relationship.json"
      }
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Provenance.json"
    },
    "body": {
      "type": "string",
      "description": "free text: the whole authored body; the archetype declares no `body_extraction`."
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "relationships",
    "provenance",
    "body"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Task record (archetype `Task`). The authored unit of work: its track, its\ndependencies and the tests it verifies. Not a record of the task being done."
}
