{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Provenance.json",
  "type": "object",
  "properties": {
    "path": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json",
      "description": "Repository-relative path of the document."
    },
    "sourceIdentity": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/SemanticId.json",
      "description": "`ix://<org>/<repo>/spec` when the caller supplies one; absent otherwise."
    },
    "digest": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Sha256Digest.json",
      "description": "SHA-256 over the line-ending-normalised document bytes (FR-011)."
    }
  },
  "required": [
    "path",
    "digest"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Where the record came from."
}
