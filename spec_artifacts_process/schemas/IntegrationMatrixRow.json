{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/IntegrationMatrixRow.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/IntegrationId.json"
    },
    "purpose": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json",
      "description": "free text: what the integration is for."
    },
    "target": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json",
      "description": "free text: the external system or component."
    },
    "type": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json",
      "description": "free text: the integration kind (`service`, `browser`, `event`, `database`); the column has no declared vocabulary."
    },
    "testCases": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json",
      "description": "free text: the test-case cell."
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/CoverageStatus.json"
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/LineNumber.json"
    }
  },
  "required": [
    "id",
    "purpose",
    "target",
    "type",
    "testCases",
    "status",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `## Integration Test Matrix` row of a TestMatrixIndex."
}
