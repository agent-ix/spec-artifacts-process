{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Plan.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/MixedDocId.json"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json"
    },
    "type": {
      "type": "string",
      "const": "Plan"
    },
    "object": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/ObjectTypeName.json"
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/NonEmptyText.json",
      "description": "free text: the authored lifecycle word (`active`, `done`); the archetype declares no vocabulary for it."
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Relationship.json"
      }
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/0.2.0/Provenance.json"
    },
    "body": {
      "type": "string",
      "description": "free text: the whole authored body; the archetype declares no `body_extraction`."
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "relationships",
    "provenance",
    "body"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Plan record (archetype `Plan`). The authored plan: its scope, its tracks and\nits gates. It carries nothing about an execution of that plan — no start, no\nfinish, no outcome (FR-013)."
}
