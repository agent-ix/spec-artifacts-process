{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/FunctionalCoverageRow.json",
  "type": "object",
  "properties": {
    "functionalReq": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the requirement cell as authored."
    },
    "acceptanceCriteria": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the criteria cell; ranges and elisions are authored here and are not expanded."
    },
    "testCases": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the test-case cell."
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/CoverageStatus.json"
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/LineNumber.json"
    }
  },
  "required": [
    "functionalReq",
    "acceptanceCriteria",
    "testCases",
    "status",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `### Functional Requirement Coverage` row (`Functional Req | Acceptance Criteria | Test Cases | Status`)."
}
